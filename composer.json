  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "wexample/php-helpers": ">=2.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "*"
  }
}
